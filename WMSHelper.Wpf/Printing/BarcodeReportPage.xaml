<UserControl x:Class="WMSHelper.Wpf.Printing.BarcodeReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             FontFamily="pack://application:,,,/WMSHelper.Wpf;component/Fonts/Barlow/#Barlow"
             FontSize="20">
    <!--Fonts point straight at this library rather than at app resources, so
        the report prints the same in any app, whatever its App.xaml holds.-->
    <StackPanel  Grid.IsSharedSizeScope="True" Margin="48">

        <TextBlock Text="Barcode Report"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24"/>

        <!-- Header row -->
        <Border HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="1" Background="LightGray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Name"/>
                    <ColumnDefinition SharedSizeGroup="Number"/>
                    <ColumnDefinition SharedSizeGroup="PO"/>
                    <ColumnDefinition SharedSizeGroup="Barcode"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Item Name"   FontWeight="Bold" Padding="6,4"/>
                <TextBlock Grid.Column="1" Text="Item Number" FontWeight="Bold" Padding="6,4"/>
                <TextBlock Grid.Column="2" Text="PO Number"   FontWeight="Bold" Padding="6,4"/>
                <TextBlock Grid.Column="3" Text="Barcode"     FontWeight="Bold" Padding="6,4"/>
            </Grid>
        </Border>

        <!-- Data rows -->
        <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="0,0,1,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="Name"/>
                                <ColumnDefinition SharedSizeGroup="Number"/>
                                <ColumnDefinition SharedSizeGroup="PO"/>
                                <ColumnDefinition SharedSizeGroup="Barcode"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ItemName}"                Padding="6,4"/>
                            <TextBlock Grid.Column="1" Text="{Binding ItemNumber}"              Padding="6,4"/>
                            <TextBlock Grid.Column="2" Text="{Binding ItemPurchaseOrderNumber}" Padding="6,4"/>
                            <TextBlock Grid.Column="3" FontFamily="pack://application:,,,/WMSHelper.Wpf;component/Fonts/#CarolinaBar-B39-2.5-50x158x720" Text="{Binding ItemNumberToBarcode}"     Padding="6,4"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer -->
        <TextBlock Text="{Binding PageInfo, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Right"
                   Foreground="Gray"
                   Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
