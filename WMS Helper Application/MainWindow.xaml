<Window x:Class="WMS_Helper_Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_Helper_Application"
        xmlns:controls="clr-namespace:WMSHelper.Wpf.Controls;assembly=WMSHelper.Wpf"
        mc:Ignorable="d"
        Title="Item Picker" Height="600" Width="800" FontFamily="{StaticResource AppFont}"
        MinHeight="600" MinWidth="800">
    <!--TODO: Create custom top bar-->
    <WindowChrome.WindowChrome >
        <WindowChrome GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        
        <!--this is based in the app.xaml file. Change definition  to override fluent UI Theme-->
        <Style TargetType="ListBox" BasedOn="{StaticResource BorderedListBox}"/>
        <!--<Style TargetType="Button" BasedOn="{StaticResource ButtonStyling}"/>-->

        <!--Greys out Edit/Delete until a row is picked in the left list. The
            trigger only ever disables, so if the binding fails to resolve the
            buttons stay usable rather than being stuck dead.-->
        <Style x:Key="NeedsSelection" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=AvailableBarcodeLB, Path=SelectedItem}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>


        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>
        

        <!--custom max man close buttons-->
        <controls:WindowControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Background="#1d2d3d" Title="Item Picker" />
        
        

        <!--availabel items label and listbox-->
        <Label Content="Item Name"  
               Name="itemsLabel" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Top" 
               Grid.Row="1" 
               Grid.Column="0"/>
        <!--actual input text box-->
        <TextBox Name="inputTB"
                 Visibility="Visible"
                 Grid.Row="1" 
                 Grid.Column="0" 
                 Width="auto" 
                 MinHeight="35" 
                 Background="#e9e9ea" 
                 VerticalAlignment="Top" 
                 Margin="20"
                 BorderBrush="#1d1f20"                 
                 TextChanged="inputTB_TextChanged"
                     />
        <!--text placeholder text box-->
        <TextBox Name="placeholderTB"
                 Grid.Row="1" Visibility="Visible" Text="Filter Items..."
                 Grid.Column="0" 
                 Width="auto" 
                 MinHeight="35" 
                 Background="#e9e9ea" 
                 VerticalAlignment="Top" 
                 Margin="20"
                 BorderBrush="#1d1f20" 
                 IsReadOnly="True"
                 GotFocus="placeholderTB_GotFocus"              
                                
                 />

        


        <Border Grid.Row="1" Grid.Column="0"  Margin="20,65,20,20">

            <ListBox Name="AvailableBarcodeLB"  
                     Grid.Row="1" 
                     Grid.Column="0" 
                     Height="auto" 
                     Width="auto" 
                     ItemsSource="{Binding AvailableBarcodeModels }" 
                     DisplayMemberPath="ItemName"  
                     MouseDoubleClick="AvailableBarcodeLB_MouseDoubleClick"  />
            
        </Border>
        

        <!--Selected label and listbox-->

        <Label  Name="itemsMovedLabel" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Grid.Row="1" 
                Grid.Column="1" 
                Content="Items to Print"  />

        <Border Grid.Row="1" Grid.Column="1" Margin="20">
            
            <ListBox Name="SelectedBarcodeLB"   
                     Height="auto" 
                     Width="auto" 
                     ItemsSource="{Binding SelectedBarcodeModels}" 
                     DisplayMemberPath="ItemName" 
                     MouseDoubleClick="SelectedBarcodeLB_MouseDoubleClick" 
                     ScrollViewer.HorizontalScrollBarVisibility="Visible"/>
            
        </Border>

        
        <!--add / edit / delete act on the left hand list only-->
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Button Name="addItemBtn" Content="Add Item" Height="50" Width="110" Margin="5,0" Click="AddItemBtn_Click" BorderBrush="Gray" BorderThickness="2"/>

            <Button Name="editItemBtn" Content="Edit Item" Style="{StaticResource NeedsSelection}" Click="editItemBtn_Click"/>

            <Button Name="deleteItemBtn" Content="Delete Item" Style="{StaticResource NeedsSelection}" Click="deleteItemBtn_Click"/>

        </StackPanel>
        
        <!--TODO: need logic for print btn event--> 
        
        
        <Button  Name="printBtn" Content="Print" Grid.Row="2" Grid.Column="1" Height="50" Width="150" HorizontalAlignment="Center" BorderBrush="Gray" BorderThickness="2" Click="printBtn_Click"/>







    </Grid>
</Window>
