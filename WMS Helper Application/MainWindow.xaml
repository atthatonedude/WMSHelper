<Window x:Class="WMS_Helper_Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_Helper_Application"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            
            
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>
        
        <Menu Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0">
            <MenuItem Header="File">
            // TODO CREATE FILE OPTIONS
            </MenuItem>
                
            <MenuItem Header="Print">
                //TODO: CREATE COMMAND LOGIC TO PRINT PAGE
                <MenuItem Command="ApplicationCommands.Print"></MenuItem>                    
            </MenuItem>
        </Menu>

        <ListBox Grid.Row="1" Grid.Column="0" Height="350" Width="200"></ListBox>
        <ListBox Grid.Row="1" Grid.Column="1" Height="350" Width="200"></ListBox>

        <Button Content="Add Item" Click="Button_Click" Grid.Row="2" Grid.Column="0" Height="50" Width="150"/>
        <Button Content="Print" Grid.Row="2" Grid.Column="1" Height="50" Width="150"/>

        <Image sour></Image>
        






    </Grid>
</Window>
