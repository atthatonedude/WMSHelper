<Window x:Class="WMS_Helper_Application.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_Helper_Application"
        xmlns:controls="clr-namespace:WMSHelper.Wpf.Controls;assembly=WMSHelper.Wpf"
        mc:Ignorable="d"
        Title="Add Item" Height="365" Width="480"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        FontSize="14">

    <!--Same custom chrome as the main window so the dark bar below replaces
        the OS caption rather than sitting under it.-->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!--The flat field look comes from WMSHelper.Wpf's FlatTextBox. Applied
            here, rather than app-wide, so only this window's boxes get it. The
            label and button styles used below come from the same library.-->
        <Style TargetType="TextBox" BasedOn="{StaticResource FlatTextBox}"/>

    </Window.Resources>

    <Border BorderBrush="#C8CCD0" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Title text is swapped in the code-behind for edit mode.-->
            <controls:WindowControl x:Name="titleBar"
                                    Grid.Row="0"
                                    Background="#1d2d3d"
                                    Title="Add Item"
                                    IconData="M 6,1 V 11 M 1,6 H 11"
                                    ShowMinMaxButtons="False"/>

            <StackPanel Grid.Row="1" Margin="24,22,24,0">

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Item Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Name="itemNameTB"
                             Tag="e.g. Widget A"
                             Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Item Number" Style="{StaticResource FieldLabel}"/>
                    <TextBox Name="itemNumberTB"
                             Tag="0"
                             Text="{Binding ItemNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Purchase Order Number" Style="{StaticResource FieldLabel}"/>
                    <TextBox Name="itemPurchaseOrderTB"
                             Tag="0"
                             Text="{Binding ItemPurchaseOrderNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

            </StackPanel>

            <!--Content of the primary button is swapped in the code-behind when
                this window is opened in edit mode.-->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,0,24,22">

                <Button Name="cancelBtn"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"/>

                <Button Name="addItemBtn"
                        Content="Add Item"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="addItemBtn_Click"/>

            </StackPanel>

        </Grid>
    </Border>
</Window>
