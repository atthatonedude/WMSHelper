<Window x:Class="WMS_Helper_Application.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_Helper_Application"
        
        mc:Ignorable="d"
        Title="AddItemWindow" Height="500" Width="600"
        FontSize="20">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>            
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>

        
        <Label Grid.Row="0" Content="Item Name :" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox Name="itemNameTB" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Height="20" Width="200"/>
        
        <Label Grid.Row="1" Content="Item Number :" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox  Name="itemNumberTB" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Height="20" Width="200"/>
        
        
        <Label Grid.Row="2" Content="Item Purchase Order Number :" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox  Name="itemPurchaseOrderTB" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Height="20" Width="200"/>

        <StackPanel Grid.ColumnSpan="2" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Add Item" HorizontalAlignment="Center" Width="100" Margin="10"/>
            <Button Content="Back" HorizontalAlignment="Center" Width="100" Margin="10"/>
            
        </StackPanel>










    </Grid>
</Window>
