<Window x:Class="WMS_Helper_Application.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_Helper_Application"
        xmlns:controls="clr-namespace:WMS_Helper_Application.UserControls"
        mc:Ignorable="d"
        Title="Add Item" Height="365" Width="480"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        FontSize="14">

    <!--Same custom chrome as the main window so the dark bar below replaces
        the OS caption rather than sitting under it.-->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!--Flat grey field. Templated rather than restyled because the Fluent
            theme draws its own accent underline that fights the mockup.-->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F2F2F3"/>
            <Setter Property="Foreground" Value="#1D2D3D"/>
            <Setter Property="BorderBrush" Value="#D6D6D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#1D2D3D"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!--Tag carries the placeholder, so each box sets
                                    its own hint without needing a second control.-->
                                <TextBlock x:Name="placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#9AA0A6"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B9BDC2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A8FC7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#3F4A55"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!--Shared shell for both dialog buttons. Colour lives in the derived
            styles so the hover triggers there can just set Background.-->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333B44"/>
            <Setter Property="BorderBrush" Value="#C8CCD0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F2F3"/>
                    <Setter Property="BorderBrush" Value="#A9AEB4"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E4E5E7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#4A8FC7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A8FC7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F7CAE"/>
                    <Setter Property="BorderBrush" Value="#3F7CAE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#356A96"/>
                    <Setter Property="BorderBrush" Value="#356A96"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#C8CCD0" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Title text is swapped in the code-behind for edit mode.-->
            <controls:WindowControl x:Name="titleBar"
                                    Grid.Row="0"
                                    Background="#1d2d3d"
                                    Title="Add Item"
                                    IconData="M 6,1 V 11 M 1,6 H 11"
                                    ShowMinMaxButtons="False"/>

            <StackPanel Grid.Row="1" Margin="24,22,24,0">

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Item Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Name="itemNameTB"
                             Tag="e.g. Widget A"
                             Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Item Number" Style="{StaticResource FieldLabel}"/>
                    <TextBox Name="itemNumberTB"
                             Tag="0"
                             Text="{Binding ItemNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Purchase Order Number" Style="{StaticResource FieldLabel}"/>
                    <TextBox Name="itemPurchaseOrderTB"
                             Tag="0"
                             Text="{Binding ItemPurchaseOrderNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

            </StackPanel>

            <!--Content of the primary button is swapped in the code-behind when
                this window is opened in edit mode.-->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,0,24,22">

                <Button Name="cancelBtn"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"/>

                <Button Name="addItemBtn"
                        Content="Add Item"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="addItemBtn_Click"/>

            </StackPanel>

        </Grid>
    </Border>
</Window>
