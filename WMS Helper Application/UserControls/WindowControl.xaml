<UserControl x:Class="WMS_Helper_Application.UserControls.WindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_Helper_Application.UserControls"
             mc:Ignorable="d" 
             Height="25" d:DesignWidth="800">
    <!--<UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonStyling}"
    </UserControl.Resources>-->
    <Border Background="#1d2d3d">
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="minimizeBtn" BorderBrush="Black" BorderThickness=".5" Content="_"/>

            <Button Name="maximizeBTn" BorderBrush="Black" BorderThickness=".5" >

                <Viewbox  Width="16" Height="auto">
                    <Path Stroke="Black"
              StrokeThickness="1"
              Fill="Transparent"
              Data="M 1,1 H 11 V 11 H 1 Z"/>

                </Viewbox>
            </Button>

            <Button Name="closeBtn" BorderBrush="Black" BorderThickness=".5" Content="X"/>
        </StackPanel>
    </Border>

    
</UserControl>
