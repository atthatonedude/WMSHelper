<Application x:Class="WMS_Helper_Application.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WMS_Helper_Application"
             Startup="Application_Startup">
    
    
    <Application.Resources>
        <ResourceDictionary>

            <!--The Fluent theme, fonts and shared styles all come from WMSHelper.Wpf,
                so other apps can share the same look by merging the same file.-->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WMSHelper.Wpf;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Application.Resources>
</Application>

             