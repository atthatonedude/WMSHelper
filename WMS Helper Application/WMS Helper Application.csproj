<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WMS_Helper_Application</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The app itself isn't a package; only the two libraries are. -->
    <IsPackable>false</IsPackable>
    <UserSecretsId>d569b34c-6818-4722-b949-360d2c3fea81</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="ViewModel\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
  </ItemGroup>

	<!-- Core: model and SQLite data access. Dapper and Microsoft.Data.Sqlite
	     (needed here for SqliteException) come through this reference.
	     Wpf: title bar, printing, fonts and the shared styles. -->
	<ItemGroup>
	  <ProjectReference Include="..\WMSHelper.Core\WMSHelper.Core.csproj" />
	  <ProjectReference Include="..\WMSHelper.Wpf\WMSHelper.Wpf.csproj" />
	</ItemGroup>

</Project>
