<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WMS_Helper_Application</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="ViewModel\" />
  </ItemGroup>

	<ItemGroup>
		<Resource Include="MiscFiles\Fonts\**\*.ttf" />
	</ItemGroup>

	<!-- Model and SQLite data access. Dapper and Microsoft.Data.Sqlite
	     (needed here for SqliteException) come through this reference. -->
	<ItemGroup>
	  <ProjectReference Include="..\WMSHelper.Core\WMSHelper.Core.csproj" />
	</ItemGroup>

</Project>
