<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain .NET on purpose: no WPF here, so any kind of project (console,
       web, desktop) can use the model and data access, and the tests run on
       any OS. Windows-only pieces live in WMSHelper.Wpf. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WMSHelper.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package details for `dotnet pack`. The package id defaults to
       the assembly name, WMSHelper.Core. Bump Version for each release. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Description>Barcode item model and SQLite storage (Dapper + Microsoft.Data.Sqlite) shared by WMS Helper apps.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
  </ItemGroup>

</Project>
